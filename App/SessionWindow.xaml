<Window x:Class="Mnet.App.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mnet · Sesión remota"
        Width="1100"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        Icon="Assets/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="Toolbar" Background="#111A2B" Padding="16,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="RemoteNameText" Text="Conectado" Foreground="White"
                               FontFamily="Segoe UI Semibold" VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <TextBlock x:Name="StatsText" Text="" Foreground="#8FA3BF" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="FullScreenButton" Content="Pantalla completa" Width="132"
                            Style="{StaticResource GhostButton}" Click="FullScreen_Click" />
                    <Button Content="Finalizar" Width="92" Style="{StaticResource EndButton}"
                            Margin="8,0,0,0" Click="End_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True"
                   MouseMove="Image_MouseMove" MouseDown="Image_MouseDown" MouseUp="Image_MouseUp"
                   MouseWheel="Image_MouseWheel" />
            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Conectando…" Foreground="#C7D3E4" FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Esperando la primera imagen del equipo remoto."
                           Foreground="#7C8FA8" FontSize="12.5" Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border x:Name="StatusBar" Grid.Row="2" Background="#0E1626" Padding="16,7">
            <DockPanel>
                <TextBlock x:Name="SessionStatusText" Text="Sesión cifrada AES-256-GCM"
                           Foreground="#8FA3BF" FontSize="12" />
                <TextBlock x:Name="ScreenInfoText" Text="" Foreground="#8FA3BF" FontSize="12"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
