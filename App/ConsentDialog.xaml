<Window x:Class="Mnet.App.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitud de conexión"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        Icon="Assets/icon.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/icon.png" Width="46" Height="46"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Solicitud de conexión remota" Style="{StaticResource SectionTitle}"
                           FontSize="18" />
                <TextBlock Text="Alguien quiere ver y controlar este ordenador."
                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AccentWashBrush}" CornerRadius="10"
                Padding="14,12" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="CONEXIÓN DESDE" FontFamily="Segoe UI Semibold" FontSize="10.5"
                           Foreground="#5B8CC4" />
                <TextBlock x:Name="AddressText" Text="192.168.1.20" FontFamily="Consolas"
                           FontSize="19" FontWeight="SemiBold" Foreground="#134B8F" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,16,0,0"
                   Text="Si aceptas, esta persona podrá ver tu pantalla y usar el ratón y el teclado hasta que finalices la sesión. Solo deberías aceptar si conoces a quien está conectando."
                   Style="{StaticResource Caption}" FontSize="12.5" LineHeight="19" />

        <TextBlock Grid.Row="3" x:Name="CountdownText" Text="Se rechazará automáticamente en 60 s."
                   Style="{StaticResource Caption}" FontSize="11.5" Margin="0,14,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Rechazar" Width="118" Style="{StaticResource SecondaryButton}"
                    Click="Deny_Click" />
            <Button x:Name="AllowButton" Content="Permitir" Width="132" Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" Click="Allow_Click" />
        </StackPanel>
    </Grid>
</Window>
