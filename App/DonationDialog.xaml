<Window x:Class="Mconect.App.DonationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apoya Mconect"
        Width="520" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Border Width="38" Height="38" CornerRadius="11"
                    Background="{StaticResource DonateWashBrush}" DockPanel.Dock="Left">
                <TextBlock Text="♥" FontSize="20" Foreground="{StaticResource DonateHoverBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="¿Te resulta útil Mconect?" FontFamily="Segoe UI Semibold" FontSize="19" />
                <TextBlock Text="Un apoyo simbólico mantiene el desarrollo." Style="{StaticResource Caption}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,20,0,0" FontSize="13.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Mconect es software libre, sin cuentas, sin servidores intermediarios y sin anuncios. Si quieres que sigamos mejorando la conexión remota, puedes apoyarnos con PayPal o Liberapay. ¡Gracias!" />

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="PayPalButton" Content="Donar con PayPal" Height="42" Cursor="Hand"
                    Background="{StaticResource DonateBrush}" Foreground="#1D1F20"
                    FontFamily="Segoe UI Semibold" BorderThickness="0" Click="PayPal_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource DonateHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="LiberapayButton" Content="Donar con Liberapay" Height="42" Cursor="Hand"
                    Margin="0,9,0,0" Style="{StaticResource SecondaryButton}" Click="Liberapay_Click" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <CheckBox x:Name="DontShowAgain" Content="No volver a mostrar" FontSize="12"
                      Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <Button Content="Ahora no" DockPanel.Dock="Right" Width="100" Height="34" Cursor="Hand"
                    Style="{StaticResource GhostButton}" Click="Later_Click" />
        </DockPanel>
    </Grid>
</Window>
