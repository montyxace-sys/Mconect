<Window x:Class="Mnet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mnet"
        Width="1010"
        Height="665"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="Assets/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/icon.png" Width="42" Height="42"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mnet" FontFamily="Segoe UI Semibold" FontSize="22" />
                        <TextBlock Text="Escritorio remoto directo" Style="{StaticResource Caption}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderStatus" Text="Listo" Style="{StaticResource Caption}"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentWashBrush}" CornerRadius="8"
                            Padding="12,7" Margin="18,0,0,0">
                        <TextBlock x:Name="HeaderAddress" Text="192.168.1.10 · puerto 52222"
                                   Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                                   FontSize="12.5" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Conectar a un equipo remoto" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Escribe el ID del otro equipo y su contraseña de sesión."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="ID del equipo" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="IdBox" Style="{StaticResource InputBox}" />
                        <TextBlock Text="IP o IP:puerto, por ejemplo 192.168.1.20"
                                   Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        <TextBlock Text="Contraseña de sesión" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="SessionPasswordBox" Style="{StaticResource InputPassword}" />
                        <StackPanel Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Cifrado AES-256-GCM de extremo a extremo"
                                           Style="{StaticResource Caption}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Sin cuentas ni servidores intermediarios"
                                           Style="{StaticResource Caption}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="La otra persona debe aceptar la conexión"
                                           Style="{StaticResource Caption}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="ConnectError" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="ConnectButton" Content="Conectar" Style="{StaticResource PrimaryButton}"
                                Click="ConnectButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Permitir conexión remota" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Comparte tu ID y contraseña con la persona que vaya a ayudarte."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <Border Background="{StaticResource AccentWashBrush}" CornerRadius="10"
                                Padding="16,12" Cursor="Hand" ToolTip="Copiar ID al portapapeles"
                                MouseLeftButtonUp="CopyId_Click">
                            <StackPanel>
                                <TextBlock Text="TU ID" FontFamily="Segoe UI Semibold" FontSize="10.5"
                                           Foreground="#5B8CC4" />
                                <TextBlock x:Name="LocalIdText" Text="192.168.1.10" FontFamily="Consolas"
                                           FontSize="23" FontWeight="SemiBold" Foreground="#134B8F"
                                           Margin="0,2,0,0" />
                                <TextBlock x:Name="LocalPortText" Text="Puerto 52222" FontSize="11.5"
                                           Foreground="#4A7BB3" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Contraseña de la sesión" Style="{StaticResource FieldLabel}" />
                        <Border Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="12,0" Height="44">
                            <DockPanel VerticalAlignment="Center">
                                <Button x:Name="NewPasswordButton" Content="Nueva" Height="28"
                                        DockPanel.Dock="Right" Cursor="Hand"
                                        Foreground="{StaticResource AccentBrush}"
                                        Style="{StaticResource GhostButton}"
                                        Click="NewPassword_Click" />
                                <TextBlock x:Name="SessionPasswordText" FontFamily="Consolas"
                                           FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Cámbiala para cortar accesos anteriores."
                                   Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="HostButton" Content="Permitir conexiones"
                                Style="{StaticResource SecondaryButton}" Click="HostButton_Click" />
                        <TextBlock x:Name="HostStatus" Text="El acceso remoto está desactivado."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="28,0,28,16">
            <DockPanel>
                <TextBlock Text="Cifrado AES-256-GCM con claves efímeras · ECDH P-256"
                           Style="{StaticResource Caption}" FontSize="11.5" />
                <TextBlock x:Name="VersionText" Text="Mnet 0.1.0" Style="{StaticResource Caption}"
                           FontSize="11.5" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
