<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mconect.Portable.App.MainView"
             Background="#F2F5FA">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Mconect" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
      <TextBlock Text="visor portable · escritorio remoto" FontSize="12" Foreground="#6B7688"
                 VerticalAlignment="Bottom" Margin="0,0,0,3" />
    </StackPanel>

    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,12,0,0"
            BorderBrush="#E1E7F0" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Conectar a un equipo" FontWeight="SemiBold" FontSize="15" />
        <TextBox x:Name="InviteBox" Watermark="ID o invitación: 192.168.1.20:52222" />
        <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="Contraseña de la sesión" />
        <DockPanel>
          <Button x:Name="ConnectButton" Content="Conectar" Click="Connect_Click" DockPanel.Dock="Left"
                  Background="#0F86FF" Foreground="White" Padding="18,8" />
          <Button x:Name="DisconnectButton" Content="Desconectar"
                  DockPanel.Dock="Left" Margin="8,0,0,0" IsEnabled="False" Padding="14,8" />
          <TextBlock x:Name="StatusText" Text="Introduce el ID y la contraseña que te compartieron."
                     TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="#6B7688" FontSize="12" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" CornerRadius="12" Margin="0,12,0,0"
            BorderBrush="#E1E7F0" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
               PointerMoved="Screen_PointerMoved" PointerPressed="Screen_PointerPressed"
               PointerReleased="Screen_PointerReleased" PointerWheelChanged="Screen_PointerWheel"
               KeyDown="Screen_KeyDown" KeyUp="Screen_KeyUp" />
        <TextBlock x:Name="ScreenHint" Text="La pantalla remota aparecerá aquí." HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="#9AA4B5" FontSize="13" />
      </Grid>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock Text="v1.1.0 · © 2026 MSoft" DockPanel.Dock="Right" FontSize="11"
                 Foreground="#9AA4B5" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="¿Te resulta útil? Apoya Mconect:" FontSize="11" Foreground="#6B7688"
                   VerticalAlignment="Center" />
        <Button Content="PayPal" Tag="https://paypal.me/MsoftGenuino" Click="Donate_Click"
                Padding="0" Margin="0" FontSize="11" Background="Transparent"
                Foreground="#E6B333" BorderThickness="0" Cursor="Hand" />
        <TextBlock Text="·" FontSize="11" Foreground="#6B7688" VerticalAlignment="Center" />
        <Button Content="Liberapay" Tag="https://liberapay.com/Msoft/donate" Click="Donate_Click"
                Padding="0" Margin="0" FontSize="11" Background="Transparent"
                Foreground="#E6B333" BorderThickness="0" Cursor="Hand" />
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
